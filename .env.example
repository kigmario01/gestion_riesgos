APP_NAME="RiskGuard TI"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://riskguard.tu-dominio.com
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=riskguard
DB_USERNAME=riskguard
DB_PASSWORD=riskguard
DB_SOCKET=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_CONNECTION=default

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis
CACHE_PREFIX=riskguard

REDIS_HOST=redis
REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_CLIENT=phpredis
REDIS_QUEUE_CONNECTION=default
REDIS_CACHE_CONNECTION=cache

MAIL_MAILER=log
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@riskguard.local
MAIL_FROM_NAME="RiskGuard TI"

VITE_APP_NAME="RiskGuard TI"
TRUSTED_PROXIES=*
TRUSTED_HOSTS=*

DEBUGBAR_ENABLED=false
