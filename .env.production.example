# Copy this file to .env on the Ubuntu server. Do not commit that .env file.
COMPOSE_PROJECT_NAME=riskguard
APP_IMAGE=riskguard-app:latest
HTTP_PORT=8080
HTTP_BIND_ADDRESS=0.0.0.0
BACKUP_PATH=/srv/riskguard/backups/mysql

APP_NAME="RiskGuard TI"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://riskguard.midominio.com
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

LOG_CHANNEL=stack
LOG_STACK=daily,stderr
LOG_LEVEL=info

DB_PORT=3306
DB_CONNECTION=mysql
DB_HOST=mysql
DB_DATABASE=riskguard
DB_USERNAME=riskguard
DB_PASSWORD=CHANGE_ME
MYSQL_ROOT_PASSWORD=CHANGE_ME

SESSION_LIFETIME=120
SESSION_DRIVER=redis
SESSION_CONNECTION=default
SESSION_SECURE_COOKIE=true
CACHE_STORE=redis
CACHE_PREFIX=riskguard
REDIS_HOST=redis
REDIS_PASSWORD=CHANGE_ME
QUEUE_CONNECTION=redis

FILESYSTEM_DISK=local
MAIL_MAILER=log
MAIL_HOST=localhost
MAIL_PORT=25
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@midominio.com
MAIL_FROM_NAME="RiskGuard TI"

# Cloudflared forwards the original protocol. Restrict this further if the
# tunnel source IP is fixed in your setup.
TRUSTED_PROXIES=*
TRUSTED_HOSTS=riskguard.midominio.com
RUN_MIGRATIONS=true
