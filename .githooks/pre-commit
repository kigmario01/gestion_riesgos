#!/usr/bin/env bash
# ==============================================================================
# Git Pre-Commit Hook: Secret Scanning & Environment File Protection
# ==============================================================================

set -e

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

ERRORS=0

echo -e "${YELLOW}[DevSecOps] Ejecutando escaneo preventivo pre-commit...${NC}"

# 1. Validar nombres de archivos sensibles preparados (staged)
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)

for FILE in $STAGED_FILES; do
    BASENAME=$(basename "$FILE")
    
    # Prohibir archivos .env que no sean ejemplos
    if [[ "$BASENAME" =~ ^\.env ]] && [[ ! "$BASENAME" =~ \.example$ ]]; then
        echo -e "${RED}[ERROR DE SEGURIDAD] Intento de commit de archivo de entorno sensible:${NC} $FILE"
        ERRORS=$((ERRORS + 1))
    fi

    # Prohibir certificados, llaves privadas y credenciales
    if [[ "$BASENAME" =~ \.(pem|key|pfx|p12|pkcs12)$ ]] || [[ "$BASENAME" =~ id_rsa|id_ed25519 ]]; then
        echo -e "${RED}[ERROR DE SEGURIDAD] Intento de commit de certificado o llave privada:${NC} $FILE"
        ERRORS=$((ERRORS + 1))
    fi

    # Prohibir volcados de base de datos o sqlite locales
    if [[ "$BASENAME" =~ \.(sqlite|sqlite3|db)$ ]]; then
        echo -e "${RED}[ERROR DE SEGURIDAD] Intento de commit de base de datos local:${NC} $FILE"
        ERRORS=$((ERRORS + 1))
    fi
done

# 2. Escaneo de contenido sensible en lineas agregadas (+)
STAGED_DIFF=$(git diff --cached -U0 --diff-filter=ACM -- . ':!.env.example' ':!.env.production.example' ':!.githooks/*')

check_pattern() {
    local PATTERN="$1"
    local DESC="$2"
    if echo "$STAGED_DIFF" | grep -E "^\+" | grep -E -q -e "$PATTERN"; then
        echo -e "${RED}[ERROR DE SEGURIDAD] Se detecto patron sensible ($DESC) en el diff preparado.${NC}"
        ERRORS=$((ERRORS + 1))
    fi
}

check_pattern "-----BEGIN [A-Za-z0-9 ]*PRIVATE KEY" "Llave Privada SSH/RSA"
check_pattern "APP_KEY=base64:[A-Za-z0-9+/=]{40,}" "Laravel APP_KEY activa"
check_pattern "(AKIA|ASIA)[0-9A-Z]{16}" "AWS Access Key"
check_pattern "(ghp|gho|ghu|ghs|ghr|github_pat)_[A-Za-z0-9_]{36}" "GitHub Token"
check_pattern "xox[baprs]-[0-9]{12}" "Slack Token"
check_pattern "sk_live_[0-9a-zA-Z]{24}" "Stripe Secret Live Key"
check_pattern "AIza[0-9A-Za-z_-]{35}" "Google API Key"

if [ $ERRORS -gt 0 ]; then
    echo -e "\n${RED}================================================================${NC}"
    echo -e "${RED}COMMIT CANCELADO: Se detectaron $ERRORS violacion(es) de seguridad.${NC}"
    echo -e "${RED}Remueve los archivos o secretos con 'git reset HEAD <archivo>' antes de commitear.${NC}"
    echo -e "${RED}================================================================${NC}\n"
    exit 1
fi

echo -e "${GREEN}[DevSecOps] Escaneo pre-commit exitoso: Repositorio limpio.${NC}"
exit 0
